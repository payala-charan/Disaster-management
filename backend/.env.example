DATABASE_URL=postgresql+psycopg://disaster:disaster@localhost:5434/disaster_db

# LLM: gemini | openai | none (none = deterministic fallback only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# For OpenAI instead: LLM_PROVIDER=openai, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_S=10

# External data: live | simulation
WEATHER_MODE=live
ROUTING_MODE=live
HTTP_TIMEOUT_S=5
WEATHER_CACHE_MIN=10
GEOCODING_NOMINATIM=false

# Thresholds
SHELTER_ALERT_THRESHOLD=0.85
DUPLICATE_DISTANCE_M=500
DUPLICATE_TIME_WINDOW_MIN=60

# Services
CORS_ORIGINS=["http://localhost:5173"]
OVERDUE_CHECK_S=60
# REPORTS_DIR=./reports
# Local dev: any localhost port is allowed; set CORS_ORIGIN_REGEX= (empty) in production
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?
